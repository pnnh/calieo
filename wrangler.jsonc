{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "calieo",
	"compatibility_date": "2026-05-09",
	"main": ".open-next/worker.js",
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"logs": { "enabled": true }
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "calieo-portal",
			"database_id": "7bab5336-0005-4f62-9e6b-ac631c9a0788",
			"remote": true
		}
	],
	"vars": {
		"CALIEO_OIDC_CLIENT_ID": "prism_munRwBbfnENuBx1MIEfghQ",
		"CALIEO_OIDC_CLIENT_SECRET": "your_client_secret_here",
		"CALIEO_OIDC_ISSUER": "https://portal.calieo.xyz",
		"CALIEO_OIDC_REDIRECT_URI": "https://calieo.xyz/api/auth/calieo/callback",
		"SESSION_TTL_DAYS": "7"
	},
	"r2_buckets": [
		{
			"binding": "FILES_BUCKET",
			"bucket_name": "calieo-files"
		},
		{
		"bucket_name": "calieo-files",
		"binding": "NEXT_INC_CACHE_R2_BUCKET"
		}
	]
}